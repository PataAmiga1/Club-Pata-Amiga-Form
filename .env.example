# Copy to .env.local and fill in. NEVER commit real values.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (use sk_test_/pk_test_ keys in development)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=

# Resend
RESEND_API_KEY=
EMAIL_FROM=Club Pata Amiga <onboarding@resend.dev>

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cron (Vercel se autentica solo; esto es para llamadas manuales/externas)
CRON_SECRET=

# Google Maps Places (autocompletado de direcciones)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Agentes IA (bot vet, asistente del portal, agente de ventas). "mock" funciona sin key real.
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Canales Meta: Messenger + Instagram DM + WhatsApp
META_VERIFY_TOKEN=
META_APP_SECRET=
# Solo desarrollo local: 1 = aceptar webhooks de Meta SIN firma (ignorado en produccion)
META_WEBHOOK_ALLOW_UNSIGNED=
META_PAGE_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# Flowly: puerta de WhatsApp (coexistencia), Messenger e Instagram hacia /ventas.
# Qué canal entra por Flowly se elige en Portal de ventas → IA → "Proveedor por canal".
# La llave (flw_live_…) y el secreto del webhook (whsec_…) los da el operador de
# Flowly UNA vez; van solo en el servidor (Vercel), nunca en el repo.
FLOWLY_API_BASE=https://app.flowlysync.com/api/v1
FLOWLY_API_KEY=
FLOWLY_WEBHOOK_SECRET=
# Solo mientras se rota el secreto (unos minutos): el anterior.
FLOWLY_WEBHOOK_SECRET_ANTERIOR=
# 1 = aceptar webhooks SIN firma cuando no hay secreto. Solo desarrollo local;
# en producción (NODE_ENV=production) se ignora y el webhook falla cerrado.
FLOWLY_WEBHOOK_SIN_FIRMA=

# --- Puente legacy Memberstack (mientras dure la migracion de passwords) ---
NEXT_PUBLIC_MEMBERSTACK_APP_ID=
NEXT_PUBLIC_MEMBERSTACK_PUBLIC_KEY=
MEMBERSTACK_ADMIN_SECRET_KEY=

ADMIN_SECRET_CODE=

# Medicion (src/lib/analytics.ts): sin llave no se carga nada, y nada sin el "si" de cookies
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_CLARITY_ID=
# API de Conversiones de Meta (src/lib/medicion/capi-servidor.ts). Sin token = no hace nada.
# Token: Administrador de eventos -> el pixel -> Configuracion -> API de Conversiones -> Generar token
META_CAPI_ACCESS_TOKEN=
# Opcional: codigo de la pestana "Probar eventos" (quitarlo al terminar de probar)
META_CAPI_TEST_EVENT_CODE=
# Opcional: version de la Graph API (por omision v24.0)
META_CAPI_API_VERSION=
